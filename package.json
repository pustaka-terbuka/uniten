{
  "name": "pustaka-terbuka-uniten",
  "version": "1.0.0",
  "description": "Perpustakaan Universiti Tenaga Nasional (UNITEN) Bibliographic Dataset and Harvester for Pustaka Terbuka.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate-inbox": "node tools/validate-inbox.js",
    "merge": "node tools/merge.js",
    "harvest": "node tools/harvesters/uniten/harvester.js",
    "harvest:sample": "node tools/harvesters/uniten/harvester.js --max-records 10",
    "harvest:chunked": "node tools/harvesters/uniten/harvester.js --chunk-size 10000",
    "harvest:master": "node tools/harvesters/uniten/harvester.js --chunk-size 10000 --master-digest",
    "ingest:master": "node tools/ingest-to-master.js",
    "ingest:opac": "node tools/ingest-to-master.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.11.2"
  }
}